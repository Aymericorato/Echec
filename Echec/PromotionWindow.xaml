<Window x:Class="Echec.PromotionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Echec"
        mc:Ignorable="d"
        Title="Promotion" Height="170" Width="400">
    <Grid>
        <StackPanel Orientation="Vertical" Name="Titre_Piece">
            <TextBlock>
                Choisissez votre pièce :
            </TextBlock>
            <StackPanel Orientation="Horizontal">
                <Image x:Name="imgDame" MouseLeftButtonDown="imgDame_MouseLeftButtonDown" Cursor="Hand" Width="100" Height="97" Stretch="Uniform"></Image>
                <Image x:Name="imgTour" MouseLeftButtonDown="imgTour_MouseLeftButtonDown" Cursor="Hand" Width="100" Height="97" Stretch="Uniform"></Image>
                <Image x:Name="imgFou" MouseLeftButtonDown="imgFou_MouseLeftButtonDown" Cursor="Hand" Width="100" Height="97" Stretch="Uniform"></Image>
                <Image x:Name="imgCavalier" MouseLeftButtonDown ="imgCavalier_MouseLeftButtonDown" Cursor="Hand" Width="100" Height="97" Stretch="Uniform"></Image>
            </StackPanel>
        </StackPanel>

    </Grid>
</Window>
